---
interface Props {
  label: string;
  variant?: 'tech' | 'complete' | 'active' | 'practice';
}

const { label, variant = 'tech' } = Astro.props;

const styles = {
  tech: 'bg-[var(--color-surface)] border border-[var(--color-border)] text-[var(--color-text-muted)]',
  complete: 'bg-green-500/10 border border-green-500/20 text-green-400',
  active: 'bg-amber-500/10 border border-amber-500/20 text-amber-400',
  practice: 'bg-blue-500/10 border border-blue-500/20 text-blue-400',
};
---

<span class:list={['inline-flex items-center px-2 py-0.5 rounded text-xs font-mono', styles[variant]]}>
  {label}
</span>
