---
import ThemeToggle from '../react/ThemeToggle';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/experience', label: 'Experience' },
  { href: '/skills', label: 'Skills' },
  { href: '/achievements', label: 'Achievements' },
  { href: '/services', label: 'Services' },
  { href: '/contact', label: 'Contact' },
];

const pathname = Astro.url.pathname;

// Normalise trailing slash for comparison
const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href + '/');
};
---

<header class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-bg)]/90 backdrop-blur-sm">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">

      <!-- Logo -->
      <a
        href="/"
        class="text-lg font-bold tracking-tight text-[var(--color-text)] hover:text-[var(--color-accent)] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] rounded"
        aria-label="Mukundan Gopalachary — home"
      >
        MG
      </a>

      <!-- Desktop nav -->
      <nav aria-label="Main navigation" class="hidden md:flex items-center gap-6">
        {navLinks.map(({ href, label }) => {
          const active = isActive(href);
          return (
            <a
              href={href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'relative text-sm transition-colors pb-0.5',
                active
                  ? 'text-[var(--color-accent)] after:absolute after:bottom-[-2px] after:left-0 after:w-full after:h-[2px] after:bg-[var(--color-accent)] after:rounded-full'
                  : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)]',
              ]}
            >
              {label}
            </a>
          );
        })}
      </nav>

      <!-- Right side: theme toggle + mobile menu -->
      <div class="flex items-center gap-3">
        <ThemeToggle client:load />

        <!-- Mobile menu toggle -->
        <label
          for="mobile-menu-toggle"
          class="md:hidden cursor-pointer p-2 text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors rounded focus-within:outline-none"
          aria-label="Open navigation menu"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
            focusable="false"
          >
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
        </label>
      </div>
    </div>
  </div>

  <!-- Mobile nav (CSS-only toggle) -->
  <input
    type="checkbox"
    id="mobile-menu-toggle"
    class="peer sr-only"
    aria-hidden="true"
  />
  <nav
    aria-label="Mobile navigation"
    aria-hidden="true"
    class="hidden peer-checked:block peer-checked:[aria-hidden=false] md:hidden border-t border-[var(--color-border)] bg-[var(--color-surface)]"
    id="mobile-nav"
  >
    <div class="mx-auto max-w-6xl px-4 py-4 flex flex-col gap-3">
      {navLinks.map(({ href, label }) => {
        const active = isActive(href);
        return (
          <a
            href={href}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'text-sm py-1.5 transition-colors border-l-2 pl-3',
              active
                ? 'text-[var(--color-accent)] border-[var(--color-accent)]'
                : 'text-[var(--color-text-muted)] border-transparent hover:text-[var(--color-text)] hover:border-[var(--color-border)]',
            ]}
          >
            {label}
          </a>
        );
      })}
    </div>
  </nav>
</header>

<script>
  // Sync aria-hidden on mobile nav with checkbox state
  const toggle = document.getElementById('mobile-menu-toggle') as HTMLInputElement | null;
  const nav = document.getElementById('mobile-nav');

  if (toggle && nav) {
    const syncAria = () => {
      nav.setAttribute('aria-hidden', toggle.checked ? 'false' : 'true');
    };
    toggle.addEventListener('change', syncAria);
    syncAria();
  }
</script>
